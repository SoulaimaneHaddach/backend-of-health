# ======================
# Database
# ======================
DB_HOST=mysql.example.com
DB_PORT=3306
DB_NAME=healing_db
DB_USER=healing_user
DB_PASSWORD=<CHANGE_ME>

# ======================
# Redis
# ======================
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=<CHANGE_ME_IF_AUTH_REQUIRED>
REDIS_SSL=false

# ======================
# JWT
# ======================
JWT_SECRET=<GENERATE_LONG_RANDOM_SECRET_64_CHARS_MIN>

# ======================
# Spring
# ======================
SPRING_PROFILES_ACTIVE=prod

# ======================
# JVM
# ======================
JAVA_TOOL_OPTIONS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+HeapDumpOnOutOfMemoryError -XX:+ExitOnOutOfMemoryError
