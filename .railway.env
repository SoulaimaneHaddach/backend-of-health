# Railway Environment Variables Template
# Copy environment variable definitions from Railway dashboard into this format
# DO NOT commit secrets to version control
# Railway will securely manage these via its dashboard

# =====================================================
# RAILWAY SERVICE LINKING (Generated automatically)
# =====================================================
# These use Railway's template syntax: ${{ ServiceName.VARIABLE }}
# Railway injects actual values at runtime

# MySQL Linked Service
MYSQL_USER=${{ MySQL.MYSQL_USER }}
MYSQL_PASSWORD=${{ MySQL.MYSQL_PASSWORD }}
MYSQL_ROOT_PASSWORD=${{ MySQL.MYSQL_ROOT_PASSWORD }}
MYSQL_DATABASE=${{ MySQL.MYSQL_DATABASE }}
RAILWAY_PRIVATE_HOST_MYSQL=${{ MySQL.RAILWAY_PRIVATE_HOST }}
RAILWAY_PUBLIC_HOST_MYSQL=${{ MySQL.RAILWAY_PUBLIC_HOST }}
RAILWAY_PRIVATE_PORT_MYSQL=${{ MySQL.RAILWAY_PRIVATE_PORT }}

# Redis Linked Service
REDIS_PASSWORD=${{ Redis.REDIS_PASSWORD }}
RAILWAY_PRIVATE_HOST_REDIS=${{ Redis.RAILWAY_PRIVATE_HOST }}
RAILWAY_PUBLIC_HOST_REDIS=${{ Redis.RAILWAY_PUBLIC_HOST }}
RAILWAY_PRIVATE_PORT_REDIS=${{ Redis.RAILWAY_PRIVATE_PORT }}

# =====================================================
# APPLICATION - Spring Boot Configuration
# =====================================================

# Active profile (must be 'prod' for production)
SPRING_PROFILES_ACTIVE=prod

# =====================================================
# DATABASE - MySQL
# =====================================================

# Use private Railway host for internal communication (same VPC)
DB_HOST=${{ MySQL.RAILWAY_PRIVATE_HOST }}
DB_PORT=${{ MySQL.RAILWAY_PRIVATE_PORT }}
DB_NAME=healing_db
DB_USER=${{ MySQL.MYSQL_USER }}
DB_PASSWORD=${{ MySQL.MYSQL_PASSWORD }}

# Connection pool optimization
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=10
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# =====================================================
# REDIS - Distributed Caching
# =====================================================

# Cache type (use Redis in production)
SPRING_CACHE_TYPE=redis

# Redis connection
SPRING_REDIS_HOST=${{ Redis.RAILWAY_PRIVATE_HOST }}
SPRING_REDIS_PORT=${{ Redis.RAILWAY_PRIVATE_PORT }}
SPRING_REDIS_PASSWORD=${{ Redis.REDIS_PASSWORD }}
SPRING_REDIS_SSL=false

# Redis timeout
SPRING_REDIS_TIMEOUT=2000

# =====================================================
# JWT - Authentication
# =====================================================

# Generate a strong 64+ character secret and store securely
# Use: openssl rand -base64 32 | tr -d '\n' && echo
JWT_SECRET=<GENERATE_AND_SET_IN_RAILWAY_DASHBOARD>
JWT_EXPIRATION=3600000

# =====================================================
# LOGGING - Production Level
# =====================================================

# Minimal logging to reduce I/O overhead
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_RICKBOT_HEALING_BACKEND=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN
LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN

# =====================================================
# JVM - Runtime Optimization
# =====================================================

# G1GC garbage collector, 75% of container memory
# ExitOnOutOfMemoryError to trigger container restart on OOM
JAVA_TOOL_OPTIONS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+HeapDumpOnOutOfMemoryError -XX:+ExitOnOutOfMemoryError

# =====================================================
# NOTIFICATIONS - Optional Feature Toggle
# =====================================================

# Set to false in staging to disable push notifications
APP_NOTIFICATIONS_PUSH_ENABLED=true

# =====================================================
# SERVER - HTTP Configuration
# =====================================================

# Server port (Railway will expose internally on 8080)
SERVER_PORT=8080

# Compression for response optimization
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=1024

# Application name for metrics
SPRING_APPLICATION_NAME=healing_backend

# =====================================================
# ACTUATOR - Monitoring & Metrics
# =====================================================

# Expose health and metrics endpoints
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,prometheus,info

# Health check detail level
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# Metrics export to Prometheus
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# =====================================================
# RAILWAY-SPECIFIC (Infrastructure Metadata)
# =====================================================

# Auto-injected by Railway CLI/Dashboard
# RAILWAY_SERVICE_ID=<auto>
# RAILWAY_DEPLOYMENT_ID=<auto>
# RAILWAY_ENVIRONMENT_ID=<auto>
# RAILWAY_PROJECT_ID=<auto>
# RAILWAY_VOLUME_MOUNT_PATH=<auto>

# =====================================================
# CUSTOM DOMAIN (Optional)
# =====================================================

# If using custom domain instead of Railway's default
# DOMAIN_NAME=api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =====================================================
# MONITORING & ALERTING (Optional)
# =====================================================

# If integrating with external monitoring tools
# SENTRY_DSN=<optional-error-tracking>
# DATADOG_API_KEY=<optional-metrics-export>
# NEW_RELIC_LICENSE_KEY=<optional-apm>
